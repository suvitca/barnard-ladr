<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.short_name }} — {{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <a class="topbar-brand" href="/">Barnard <b>LADR</b></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="sidebar">Menu</button>
  </header>

  <aside class="sidebar" id="sidebar">
    <button class="sidebar-close" aria-label="Close menu">Close</button>
    <a class="brand" href="/">
      <span class="brand-school">Barnard</span>
      <span class="brand-mark">LADR</span>
      <span class="brand-name">Language Acquisition and Development Research Lab</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- set active = (item.url == "/" and page.url == "/") or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="sidebar-foot">
      <a class="cv-link" href="{{ site.cv | file }}">Download CV <span>PDF, updated {{ site.cv_updated }}</span></a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <address>{% for line in site.address %}{{ line }}<br>{% endfor %}</address>
    </div>
  </aside>

  <main id="main">
    {{ content | safe }}

    <footer class="site-footer">
      <div>
        <strong>{{ site.name }}</strong><br>
        {{ site.institution }}
      </div>
      <div>
        {% for line in site.address %}{{ line }}<br>{% endfor %}
      </div>
      <div>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
        Voice {{ site.phone }}<br>
        VP {{ site.videophone }}
      </div>
      <p class="fine">© {{ "" | currentYear }} {{ site.short_name }}. {{ site.funding }}</p>
    </footer>
  </main>

  <script src="/assets/js/site.js"></script>
</body>
</html>
